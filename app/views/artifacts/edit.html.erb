<h1><%= t(".title") %></h1>

<%# エラーメッセージ %>
<%= render "shared/error_messages",
  resource: @artifact %>


<%= form_with model: @artifact do |form| %>
  <%= form.fields_for :review_condition do |condition_form| %>
    <h2><%= t("common.review_condition") %></h2>

    <div>
      <%= condition_form.label :purpose %>
      <%= condition_form.text_field :purpose %>
    </div>

    <div>
      <%= condition_form.label :target %>

      <%= condition_form.select :target,
        ReviewCondition.targets.keys.map { |target|
          [ReviewCondition.target_label(target), target]
        } %>
    </div>

    <div>
      <%= condition_form.label :tone %>

      <%= condition_form.select :tone,
        ReviewCondition.tones.keys.map{ |tone|
          [ReviewCondition.tone_label(tone), tone]
        } %>
    </div>
  <% end %>

  <h2><%= t("common.artifact") %></h2>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <%# ファイル %>
  <div>
    <%= form.label :file, t("common.file") %>

    <% if @artifact.file.attached? %>
      <p>
        現在のファイル：
        <%= link_to(
          @artifact.file.filename.to_s,
          rails_blob_path(
            @artifact.file,
            disposition: "attachment"
          )
        ) %>
      </p>
    <% else %>
      <p>現在、ファイルは登録されていません。</p>
    <% end %>

    <%= form.file_field :file %>

    <p>
      ※新しいファイルを選択すると、現在のファイルが差し替えられます。
    </p>
  </div>

  <div>
    <%= form.label :review_deadline %>
    <%= form.date_field :review_deadline %>
  </div>

  <%# Approver選択 %>
  <h3><%= t("common.approver")%></h3>

  <% @users.each do |user| %>
    <div>
      <%= radio_button_tag(
        "artifact[approver_id]",
        user.id,
        @artifact.artifact_reviewers
                .approver
                .exists?(user: user)
      ) %>

      <%= user.name %>
    </div>
  <% end %>

  <%# Reviewer選択 %>
  <h3><%= t("common.reviewer")%></h3>

  <% @users.each do |user| %>
    <div>
      <%= check_box_tag(
        "artifact[reviewer_ids][]",
        user.id,
        @artifact.artifact_reviewers
                .reviewer
                .exists?(user: user)
      ) %>

      <%= user.name %>
    </div>
  <% end %>

  <div>
    <%= form.submit t("common.submit") %>
  </div>

<% end %>

<%= link_to t("common.back"),
  artifact_path(@artifact) %>