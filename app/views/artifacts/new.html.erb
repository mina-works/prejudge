<h1><%= t(".title") %></h1>

<%# エラーメッセージ %>
<%= render "shared/error_messages",
  resource: @artifact %>


<%= form_with model: @artifact do |form| %>

  <%= form.hidden_field :creator_id, value: User.last.id %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :review_deadline %>
    <%= form.date_field :review_deadline %>
  </div>

  <%# Approver選択 %>
  <h3><%= t("common.approver")%></h3>

  <% @users.each do |user| %>
    <div>
      <%= radio_button_tag(
        "artifact[approver_id]",
        user.id
      ) %>

      <%= user.name %>
    </div>
  <% end %>

  <%# Reviewer選択 %>
  <h3><%= t("common.reviewer")%></h3>

  <% @users.each do |user| %>
    <div>
      <%= check_box_tag(
        "artifact[reviewer_ids][]",
        user.id
      ) %>

      <%= user.name %>
    </div>
  <% end %>

  <div>
    <%= form.submit t("common.submit") %>
  </div>

<% end %>