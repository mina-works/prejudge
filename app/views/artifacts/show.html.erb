<h1><%= t(".title") %></h1>

<p>
  ID:
  <%= @artifact.id %>
</p>

<p>
  <%= Artifact.human_attribute_name(:title) %> :
  <%= @artifact.title %>
</p>

<p>
  <%= Artifact.human_attribute_name(:creator) %>:
  <%= @artifact.creator.name %>
</p>

<p>
  <%= Artifact.human_attribute_name(:description) %>:
  <%= @artifact.description %>
</p>

<p>
  <%= Artifact.human_attribute_name(:status) %>:
  <%= @artifact.status_label %>
</p>

<p>
  <%= Review.human_attribute_name(:round) %>:
  <%= @artifact.current_round %>
</p>

<p>
  <%= Artifact.human_attribute_name(:created_at) %>:
  <%= @artifact.created_at %>
</p>

<p>
  <%= Artifact.human_attribute_name(:review_deadline) %>:
  <%= @artifact.review_deadline %>
</p>

<h2><%= link_to t("reviews.index.title"), artifact_reviews_path(@artifact) %></h2>

<table>
  <thead>
    <tr>
      <th><%= Review.human_attribute_name(:round) %></th>
      <th><%= t(".review_count") %></th>
      <th><%= Review.result_label(:ok) %></th>
      <th><%= Review.result_label(:uneasy) %></th>
      <th><%= Review.result_label(:ng) %></th>
    </tr>
  </thead>

  <tbody>
    <% @reviews_by_round.each do |round, reviews| %>
      <tr>
        <td>第<%= round %>回</td>
        <td><%= reviews.count %></td>
        <td><%= reviews.count(&:ok?) %></td>
        <td><%= reviews.count(&:uneasy?) %></td>
        <td><%= reviews.count(&:ng?) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%# 再提出 %>
<% if @artifact.revision_required? %>
  <%= button_to(
    t(".resubmit"),
    resubmit_artifact_path(@artifact),
    method: :patch
  ) %>
<% end %>

<%# 作成 %>
<%= link_to t("common.create"),
  new_artifact_review_path(
    @artifact
  ) %>

<%# 編集 %>
<% if @artifact.editable? %>
  <%= link_to t("common.edit"),
    edit_artifact_path(@artifact) %>
<% end %>

<%# 一覧へ戻る %>
<%= link_to t("common.back_to_list"), artifacts_path %>