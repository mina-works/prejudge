<h1><%= t(".title") %></h1>

<h2><%= t(".reviewer_title") %></h2>

<table id="reviewer-artifacts">
  <thead>
    <tr>
      <th><%= Artifact.human_attribute_name(:title) %></th>
      <th><%= Artifact.human_attribute_name(:creator) %></th>
      <th><%= t("common.approver") %></th>
      <th><%= Review.human_attribute_name(:round) %></th>
      <th><%= Artifact.human_attribute_name(:review_deadline) %></th>
    </tr>
  </thead>

  <tbody>
    <% @reviewer_artifacts.each do |artifact| %>
      <tr>
        <td><%= link_to artifact.title, artifact_path(artifact) %></td>
        <td><%= artifact.creator.name %></td>
        <td><%= artifact.approver&.name || "-" %></td>
        <td><%= artifact.current_round %></td>
        <td><%= l artifact.review_deadline, format: :short %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @reviewer_artifacts.empty? %>
  <p><%= t(".empty") %></p>
<% end %>

<h2><%= t(".approver_title") %></h2>

<table id="approver-artifacts">
  <thead>
    <tr>
      <th><%= Artifact.human_attribute_name(:title) %></th>
      <th><%= Artifact.human_attribute_name(:creator) %></th>
      <th><%= Artifact.human_attribute_name(:status) %></th>
      <th><%= Review.human_attribute_name(:round) %></th>
      <th><%= Artifact.human_attribute_name(:review_deadline) %></th>
    </tr>
  </thead>

  <tbody>
    <% @approver_artifacts.each do |artifact| %>
      <tr>
        <td><%= link_to artifact.title, artifact_path(artifact) %></td>
        <td><%= artifact.creator.name %></td>
        <td><%= artifact.status_label %></td>
        <td><%= artifact.current_round %></td>
        <td><%= l artifact.review_deadline, format: :short %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @approver_artifacts.empty? %>
  <p><%= t(".empty") %></p>
<% end %>

<h2><%= t(".creator_title") %></h2>

<table id="creator-artifacts">
  <thead>
    <tr>
      <th><%= Artifact.human_attribute_name(:title) %></th>
      <th><%= t("common.approver") %></th>
      <th><%= t("common.reviewer") %></th>
      <th><%= Artifact.human_attribute_name(:status) %></th>
      <th><%= Review.human_attribute_name(:round) %></th>
      <th><%= Artifact.human_attribute_name(:review_deadline) %></th>
    </tr>
  </thead>

  <tbody>
    <% @created_artifacts.each do |artifact| %>
      <tr>
        <td><%= link_to artifact.title, artifact_path(artifact) %></td>
        <td><%= artifact.approver&.name || "-" %></td>
        <td><%= artifact.reviewers.map(&:name).join(", ").presence || "-" %></td>
        <td><%= artifact.status_label %></td>
        <td><%= artifact.current_round %></td>
        <td><%= l artifact.review_deadline, format: :short %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @created_artifacts.empty? %>
  <p><%= t(".empty") %></p>
<% end %>
