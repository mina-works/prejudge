<h1>New Review</h1>

<%= form_with model: @review do |form| %>

  <%= form.hidden_field :artifact_id, value: Artifact.first.id %>
  <%= form.hidden_field :user_id, value: User.first.id %>

  <div>
    <%= form.label :result %>
    <%= form.select :result,
      Review.results.keys.map { |k| [k, k] } %>
  </div>

  <div>
    <p>違和感</p>

    <% ReviewIssue.issue_types.keys.each do |issue_type| %>
      <%= check_box_tag "review[issue_types][]",
        issue_type %>

      <%= label_tag issue_type %>

      <br>
    <% end %>
  </div>


  <div>
    <%= form.label :comment %>
    <%= form.text_area :comment %>
  </div>

  <div>
    <%= form.submit "送信" %>
  </div>

<% end %>