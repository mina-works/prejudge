<h1>New Review</h1>

<%# エラーメッセージ %>
<% if @review.errors.any? %>

  <div>
    <h2>
      <%= @review.errors.count %>件のエラーがあります
    </h2>

    <ul>
      <% @review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>

<% end %>

<%= form_with model: [@artifact, @review] do |form| %>

  <%= form.hidden_field :user_id, value: User.second.id %>

  <%# 判断結果 %>
  <div>
    <%= form.label :result %>
    <%= form.select :result,
      Review.results.keys.map { |k|
        [Review.result_label(k), k]
      } %>
  </div>

  <div>
    <p>違和感の理由</p>

    <% ReviewIssue.issue_types.keys.each do |issue_type| %>
      <%= check_box_tag(
        "review[issue_types][]",
        issue_type,
        false,
        id: issue_type
      ) %>

      <%= label_tag(
        issue_type,
        ReviewIssue.issue_type_label(issue_type)
      ) %>

      <br>
    <% end %>
  </div>


  <div>
    <%= form.label :comment %>
    <%= form.text_area :comment %>
  </div>

  <div>
    <%= form.submit "送信" %>
  </div>

<% end %>

<%= link_to "詳細へ戻る",
  artifact_path(@artifact) %>