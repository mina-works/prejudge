<h1><%= t(".title") %></h1>

<%# エラーメッセージ %>
<%= render "shared/error_messages",
  resource: @review %>


<%= form_with model: [@artifact, @review] do |form| %>

  <%= form.hidden_field :user_id, value: User.last.id %>

  <%# 判断結果 %>
  <div>
    <%= form.label :result %>
    <%= form.select :result,
      Review.results.keys.map { |k|
        [Review.result_label(k), k]
      } %>
  </div>

  <div>
    <p><%= t(".review_issue_reason") %></p>

    <% ReviewIssue.issue_types.keys.each do |issue_type| %>
      <%= check_box_tag(
        "review[issue_types][]",
        issue_type,
        false,
        id: issue_type
      ) %>

      <%= label_tag(
        issue_type,
        ReviewIssue.issue_type_label(issue_type)
      ) %>

      <br>
    <% end %>
  </div>


  <div>
    <%= form.label :comment %>
    <%= form.text_area :comment %>
  </div>

  <div>
    <%= form.submit t("common.submit") %>
  </div>

<% end %>

<%= link_to t("common.back"),
  artifact_path(@artifact) %>