<h1>New Review</h1>

<%= form_with model: @review do |form| %>

  <%= form.hidden_field :artifact_id, value: Artifact.first.id %>
  <%= form.hidden_field :user_id, value: User.last.id %>

  <div>
    <%= form.label :result %>
    <%= form.select :result,
      Review.results.keys.map { |k| [k, k] } %>
  </div>


  <div>
    <%= form.label :comment %>
    <%= form.text_area :comment %>
  </div>

  <div>
    <%= form.submit "送信" %>
  </div>

<% end %>