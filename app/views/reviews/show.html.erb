<h1>Review Detail</h1>

<p>
  レビューした人:
  <%= @review.user.name %>
</p>

<p>
  Result:
  <%= @review.result_label %>
</p>

<%# Issue一覧表示 %>
<% @review.review_issues.each do |issue| %>
  <p>
    <%= ReviewIssue.issue_type_label(
      issue.issue_type
    ) %>
  </p>
<% end %>

<p>
  Comment:
  <%= @review.comment %>
</p>

<%= link_to "一覧へ戻る", reviews_path %>