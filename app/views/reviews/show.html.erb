<h1><%= t(".title") %></h1>

<p>
  <%= Review.human_attribute_name(:user) %>:
  <%= @review.user.name %>
</p>

<p>
  <%= Review.human_attribute_name(:result) %>:
  <%= @review.result_label %>
</p>

<%# Issue一覧表示 %>
<% @review.review_issues.each do |issue| %>
  <p>
    <%= ReviewIssue.issue_type_label(
      issue.issue_type
    ) %>
  </p>
<% end %>

<p>
  <%= Review.human_attribute_name(:comment) %>:
  <%= @review.comment %>
</p>

<%= link_to t("common.back"), artifact_reviews_path %>